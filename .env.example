# Copy this file to .env and fill in real values — .env is gitignored
# Generate AUTH_SECRET with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"

AUTH_SECRET=replace_with_random_32_byte_hex
USER_PASSWORD=user123
ADMIN_PASSWORD=admin123

# Set to your frontend origin in production
CORS_ORIGIN=http://localhost:5173
